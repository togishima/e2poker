{
  // リポジトリ直下に置く。Workers Builds のプレビューはルートで wrangler を実行し、
  // worker/ から実行した場合も wrangler は親ディレクトリを遡ってこのファイルを見つける
  "name": "e2poker",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-01-01",
  // backend/src/room-manager.ts が node:crypto（createHash）を使うため
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "frontend/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  // Workers Builds のプレビュー（npx wrangler preview）用。
  // コードが env.ROOMS を参照するので、Preview 側にも同じバインディングが必要
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
    }
  }
}
